<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login page</title>

    
</head>

<body>

    <div class="container">

        <div class="header">
           
            <h1>Login Your Account</h1>
            
        </div>

        

        <form action="/login" method="post">

            <div class="form-group">
                <label>Email</label>
                <input type="text" name="email" class="email" placeholder="Enter Student email" required>
            </div>

             <div class="form-group">
                <label>Password</label>
                <input type="text" name="password" class="password" placeholder="Enter Student password" required>
            </div>

            <button type="submit" class="Login">
                Login
            </button>

        </form>

        <a href="/" class="back">← Loge Out></a>

    </div>

</body>

</html>